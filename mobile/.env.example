# Copy to mobile/.env and adjust. Expo exposes only variables prefixed EXPO_PUBLIC_ to the app.

# Base URL of the PollWise API, including /api/v1.
# Android emulator: http://10.0.2.2:4000/api/v1   Physical phone on the same Wi-Fi: http://<your-computer-ip>:4000/api/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api/v1
