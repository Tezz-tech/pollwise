# PollWise server environment. Copy to .env and fill in. .env is git-ignored.
# The server checks every value at boot and refuses to start if one is missing or weak.

# development | test | production
NODE_ENV=development

# Port the API listens on
PORT=4000

# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# MongoDB Atlas connection string (database user must be least-privilege, SECURITY §11).
# Local dev example: mongodb://127.0.0.1:27017/pollwise
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/pollwise

# Signing secret for access tokens (HS256). At least 32 random bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-64-random-characters-from-the-generator-above

# AES-256-GCM key that encrypts TOTP secrets at rest. Exactly 32 bytes, base64 encoded.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENC_KEY=replace-with-32-random-bytes-base64

# Comma-separated origins allowed to call the API with cookies (the admin website).
# Leave empty to allow no browser origins. The mobile app does not use CORS.
ADMIN_ORIGIN=http://localhost:5173

# How many reverse proxies sit in front of the API (0 = none). Used so rate limits see the real
# client IP (SECURITY §5). Set to 1 behind the host's proxy.
TRUST_PROXY_HOPS=0

# Public URL of the admin website. Invitation links point here.
ADMIN_PUBLIC_URL=http://localhost:5173

# SMTP for password-reset codes and admin invitations (SPEC §6, SECURITY §1).
# Required in production. Leave SMTP_HOST empty in development and the codes are not sent
# (the log says so; it never logs the code itself).
# Free tier suggestion for the client: Brevo (300 emails a day).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown to recipients. Required whenever SMTP_HOST is set.
MAIL_FROM=

# Cloudinary for course images and PDFs (SECURITY §7). Optional: without these the upload endpoints
# answer 503 UPLOADS_DISABLED and everything else still runs. Required before publishing real content.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
